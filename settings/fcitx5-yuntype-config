                buf.set_text(default)
                return
            if resp == Gtk.ResponseType.ACCEPT:
                text = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).strip()
                text = "" if text == default else text
                self.values["SentencePrompt"] = text
                write_config(self.values, self.extra)
                self.refresh_prompt_subtitle()
                self.reload_addon()
                self.toast("已保存提示词")
            dialog.destroy()

        dialog.connect("response", on_resp)
        dialog.present()

