            button.set_sensitive(True)
            try:
                conn.call_finish(res)
                remove_disk_history()
                self.toast("已清空内存与本地整句输入历史")
            except GLib.Error:
                if remove_disk_history():
                    self.toast("已删除本地历史文件（未检测到运行中的 yuntype 模块）")
