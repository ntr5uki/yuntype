def unquote_value(value):
    if len(value) >= 2 and value[0] == '"' and value[-1] == '"':
        inner = value[1:-1]
        out = []
        i = 0
        while i < len(inner):
            if inner[i] == "\\" and i + 1 < len(inner):
                nxt = inner[i + 1]
                out.append("\n" if nxt == "n" else nxt)
                i += 2
            else:
                out.append(inner[i])
                i += 1
        return "".join(out)
    return value


def quote_value(value):
    if any(c in value for c in ('\n', '"', '\\')) or value != value.strip():
        escaped = value.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")
        return f'"{escaped}"'
    return value


def read_config(path=None):
    target = path or CONFIG_FILE
    values = dict(DEFAULTS)
    extra = []
    if not os.path.isfile(target):
        return values, extra
    with open(target, encoding="utf-8", errors="replace") as f:
        in_section = False
        for raw in f:
            stripped = raw.strip()
            if not stripped or stripped.startswith("#"):
                extra.append(raw)
                continue
            if stripped.startswith("[") and stripped.endswith("]"):
                in_section = True
                extra.append(raw)
                continue
            if in_section or "=" not in raw:
                extra.append(raw)
                continue
            k, v = raw.split("=", 1)
            k = k.strip()
            v = unquote_value(v.strip())
            if k in DEFAULTS:
                if DEFAULTS[k] in ("True", "False"):
                    values[k] = v if v in ("True", "False") else DEFAULTS[k]
                elif k in RANGES:
                    lo, hi = RANGES[k]
                    try:
                        values[k] = str(max(lo, min(hi, int(v))))
                    except ValueError:
                        values[k] = DEFAULTS[k]
                else:
                    values[k] = v
            elif k in DEPRECATED_KEYS:
                continue
            else:
                extra.append(raw)
    return values, extra


def write_config(values, extra=None, path=None):
    target = path or CONFIG_FILE
    os.makedirs(os.path.dirname(target), exist_ok=True)
    lines = []
    for k, default in DEFAULTS.items():
        val = values.get(k, default)
        lines.append(f"{k}={quote_value(val)}\n")
    for raw in extra or []:
        if raw.strip():
            lines.append(raw if raw.endswith("\n") else raw + "\n")
    tmp = f"{target}.tmp.{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as f:
        f.writelines(lines)
    os.replace(tmp, target)


def read_api_key(path=None):
    target = path or KEY_FILE
    for candidate in (target, WOWTYPE_KEY_FILE) if path is None else (target,):
        if candidate and os.path.isfile(candidate):
            try:
                with open(candidate, encoding="utf-8", errors="replace") as f:
                    key = f.readline().strip()
                    if key:
                        return key
            except OSError:
                pass
    return ""


def write_api_key(key, path=None):
    target = path or KEY_FILE
    key = key.strip()
    if not key:
        try:
            os.unlink(target)
        except FileNotFoundError:
            pass
        return
    os.makedirs(os.path.dirname(target), exist_ok=True)
    tmp = f"{target}.tmp.{os.getpid()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(key + "\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, target)


def chat_endpoint(base_url):
    base = base_url.strip().rstrip("/")
    return base if base.endswith("/chat/completions") else f"{base}/chat/completions"


def models_endpoint(base_url):
    base = base_url.strip().rstrip("/")
    if base.endswith("/chat/completions"):
        base = base[: -len("/chat/completions")]
    return base if base.endswith("/models") else f"{base}/models"


def is_loopback_url(url):
    try:
        host = (urllib.parse.urlparse(url.strip()).hostname or "").lower()
    except ValueError:
        return False
    return host in ("localhost", "127.0.0.1", "::1") or host.startswith("127.")


def provider_index(url):
    norm = url.strip().rstrip("/")
    for i, (_name, purl, _model) in enumerate(PROVIDERS[:-1]):
        if purl.rstrip("/") == norm:
            return i
    return len(PROVIDERS) - 1


def make_profile_id():
    return uuid.uuid4().hex[:12]


def profile_host_label(url):
    raw = (url or "").strip()
    if not raw:
        return "未填地址"
    try:
        parsed = urllib.parse.urlparse(raw)
        if parsed.netloc:
            return parsed.netloc
    except ValueError:
        pass
    return raw


def default_profile_name(base_url, model):
    idx = provider_index(base_url)
    model = (model or "").strip()
    if idx < len(PROVIDERS) - 1:
        pname = PROVIDERS[idx][0].split("（", 1)[0]
        return f"{pname} · {model}" if model else pname
    if model:
        return model
    host = profile_host_label(base_url)
    return host if host != "未填地址" else "未命名模型"


def normalize_thinking_mode(mode):
    val = str(mode or "").strip()
    return val if val in THINKING_MODE_BY_ID else "default"


def thinking_mode_index(mode):
    norm = normalize_thinking_mode(mode)
    return THINKING_MODE_IDS.index(norm)


def resolve_extra_request_fields(thinking_mode, extra_json="", strict=True):
    mode = normalize_thinking_mode(thinking_mode)
    if mode == "default":
        return {}
    if mode == "custom":
        raw = (extra_json or "").strip()
        if not raw:
            return {}
        try:
            parsed = json.loads(raw)
        except ValueError as e:
            if strict:
                raise ApiError(f"自定义额外请求 JSON 格式无效：{e}") from None
            return {}
        if not isinstance(parsed, dict):
            if strict:
                raise ApiError("自定义额外请求 JSON 必须是 JSON 对象（例如 {\"reasoning\":{\"enabled\":false}}）")
            return {}
        conflict = sorted(k for k in parsed if k in RESERVED_REQUEST_KEYS)
        if conflict:
            if strict:
                raise ApiError(f"自定义额外请求 JSON 不能覆盖保留字段：{', '.join(conflict)}")
            return {k: v for k, v in parsed.items() if k not in RESERVED_REQUEST_KEYS}
        return parsed
    preset = THINKING_MODE_BY_ID[mode][2]
    return dict(preset) if isinstance(preset, dict) else {}


def normalize_profile(raw):
    if not isinstance(raw, dict):
        return None
    base_url = str(raw.get("base_url", "")).strip()
    model = str(raw.get("model", "")).strip()
    api_key = str(raw.get("api_key", "")).strip()
    note = str(raw.get("note", "")).strip()
    thinking_mode = normalize_thinking_mode(raw.get("thinking_mode", "default"))
    extra_request_json = str(raw.get("extra_request_json", "")).strip()
    name = str(raw.get("name", "")).strip() or default_profile_name(base_url, model)
    pid = str(raw.get("id", "")).strip() or make_profile_id()
    return {
        "id": pid,
        "name": name,
        "base_url": base_url,
        "model": model,
        "api_key": api_key,
        "note": note,
        "thinking_mode": thinking_mode,
        "extra_request_json": extra_request_json,
    }


def read_model_profiles(config_values, active_key="", path=None):
    target = path or MODELS_FILE
    profiles = []
    active_id = ""
    if os.path.isfile(target):
        try:
            with open(target, encoding="utf-8", errors="replace") as f:
                data = json.load(f)
            if isinstance(data, dict):
                active_id = str(data.get("active_id", "")).strip()
                raw_list = data.get("profiles")
                if isinstance(raw_list, list):
                    seen_ids = set()
                    for item in raw_list:
                        prof = normalize_profile(item)
                        if prof and prof["id"] not in seen_ids:
                            seen_ids.add(prof["id"])
                            profiles.append(prof)
        except (OSError, ValueError):
            profiles = []
            active_id = ""

    cur_url = (config_values.get("BaseUrl", DEFAULTS["BaseUrl"]) or "").strip()
    cur_model = (config_values.get("Model", DEFAULTS["Model"]) or "").strip()
    cur_key = (active_key or "").strip()
    cur_thinking = normalize_thinking_mode(config_values.get("ThinkingMode", DEFAULTS["ThinkingMode"]))
    cur_extra_json = (config_values.get("ExtraRequestJson", DEFAULTS["ExtraRequestJson"]) or "").strip()

    if not profiles:
        seed = {
            "id": make_profile_id(),
            "name": default_profile_name(cur_url, cur_model),
            "base_url": cur_url,
            "model": cur_model,
            "api_key": cur_key,
            "note": "",
            "thinking_mode": cur_thinking,
            "extra_request_json": cur_extra_json,
        }
        return [seed], seed["id"]

    by_id = {p["id"]: p for p in profiles}
    matched_active = by_id.get(active_id)
    if (
        not matched_active
        or matched_active["base_url"].rstrip("/") != cur_url.rstrip("/")
        or matched_active["model"] != cur_model
    ):
        found = None
        for p in profiles:
            if p["base_url"].rstrip("/") == cur_url.rstrip("/") and p["model"] == cur_model:
                found = p
                break
        if found:
            active_id = found["id"]
        elif cur_url or cur_model:
            synced = {
                "id": make_profile_id(),
                "name": default_profile_name(cur_url, cur_model),
                "base_url": cur_url,
                "model": cur_model,
                "api_key": cur_key,
                "note": "",
                "thinking_mode": cur_thinking,
                "extra_request_json": cur_extra_json,
            }
            profiles.insert(0, synced)
            active_id = synced["id"]
        else:
            active_id = profiles[0]["id"]

    return profiles, active_id


def write_model_profiles(profiles, active_id, path=None):
    target = path or MODELS_FILE
    os.makedirs(os.path.dirname(target), exist_ok=True)
    payload = {
        "version": 1,
        "active_id": active_id or (profiles[0]["id"] if profiles else ""),
        "profiles": profiles,
    }
    raw = json.dumps(payload, ensure_ascii=False, indent=2) + "\n"
    tmp = f"{target}.tmp.{os.getpid()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(raw)
    os.chmod(tmp, 0o600)
    os.replace(tmp, target)


def upsert_model_profile(
    profiles,
    editing_id,
    name,
    base_url,
    model,
    api_key,
    note="",
    thinking_mode="default",
    extra_request_json="",
):
    base_url = (base_url or "").strip()
    model = (model or "").strip()
    api_key = (api_key or "").strip()
    note = (note or "").strip()
    thinking_mode = normalize_thinking_mode(thinking_mode)
    extra_request_json = (extra_request_json or "").strip()
    name = (name or "").strip() or default_profile_name(base_url, model)
    if editing_id:
        for prof in profiles:
            if prof["id"] == editing_id:
                prof["name"] = name
                prof["base_url"] = base_url
                prof["model"] = model
                prof["api_key"] = api_key
                prof["note"] = note
                prof["thinking_mode"] = thinking_mode
                prof["extra_request_json"] = extra_request_json
                return prof, False
    created = {
        "id": make_profile_id(),
        "name": name,
        "base_url": base_url,
        "model": model,
        "api_key": api_key,
        "note": note,
        "thinking_mode": thinking_mode,
        "extra_request_json": extra_request_json,
    }
    profiles.append(created)
    return created, True


def delete_model_profile(profiles, active_id, target_id):
    if len(profiles) <= 1:
        return profiles, active_id, False, False
    new_list = [p for p in profiles if p["id"] != target_id]
    if len(new_list) == len(profiles):
        return profiles, active_id, False, False
    active_changed = target_id == active_id
    new_active = new_list[0]["id"] if active_changed else active_id
    return new_list, new_active, True, active_changed


def profile_summary(prof):
    parts = [prof.get("model") or "未填模型", profile_host_label(prof.get("base_url", ""))]
    if prof.get("api_key"):
        parts.append("已设 Key")
    elif is_loopback_url(prof.get("base_url", "")):
        parts.append("本机免 Key")
    else:
        parts.append("未设 Key")
    mode = normalize_thinking_mode(prof.get("thinking_mode", "default"))
    badge = THINKING_MODE_BY_ID[mode][3]
    if badge:
        parts.append(badge)
    if prof.get("note"):
        parts.append(prof["note"])
    return " · ".join(parts)


def opener_for(url):
    if is_loopback_url(url):
        return urllib.request.build_opener(urllib.request.ProxyHandler({}))
    return urllib.request.build_opener()


class ApiError(Exception):
    pass


def redact(text, key):
    if key and len(key) >= 4:
        return text.replace(key, "***")
    return text


def request_json(url, key, payload=None, timeout=15):
    headers = {"Accept": "application/json", "User-Agent": f"fcitx5-yuntype/{VERSION}"}
    data = None
    if payload is not None:
        headers["Content-Type"] = "application/json"
        data = json.dumps(payload, ensure_ascii=False).encode("utf-8")
    if key:
        headers["Authorization"] = f"Bearer {key}"
    req = urllib.request.Request(url, data=data, headers=headers, method="POST" if data else "GET")
    try:
        with opener_for(url).open(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            return json.loads(raw)
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="replace")
        msg = f"HTTP {e.code}"
        try:
            err = json.loads(body).get("error", {})
            detail = err.get("message") if isinstance(err, dict) else str(err)
            if detail:
                msg = f"HTTP {e.code}：{detail}"
        except ValueError:
            if body.strip():
                msg = f"HTTP {e.code}：{body.strip()[:120]}"
        if e.code == 401:
            msg = f"API Key 不对或已失效（{msg}）"
        raise ApiError(redact(msg, key)) from None
    except urllib.error.URLError as e:
        raise ApiError(redact(f"连不上服务：{e.reason}", key)) from None
    except TimeoutError:
        raise ApiError("连接超时") from None
    except ValueError as e:
        raise ApiError(f"返回格式不是 JSON：{e}") from None


def strip_think(text):
    while "<think>" in text:
        start = text.find("<think>")
        end = text.find("</think>", start + 7)
        if end == -1:
            text = text[:start]
            break
        text = text[:start] + text[end + 8 :]
    return text.strip()


def parse_model_ids(data):
    items = None
    if isinstance(data, list):
        items = data
    elif isinstance(data, dict):
        if isinstance(data.get("data"), list):
            items = data["data"]
        elif isinstance(data.get("models"), list):
            items = data["models"]
    if not isinstance(items, list):
        return []
    ids = []
    for item in items:
        if isinstance(item, str) and item.strip():
            ids.append(item.strip())
        elif isinstance(item, dict):
            val = item.get("id") or item.get("name")
            if isinstance(val, str) and val.strip():
                ids.append(val.strip())
    return sorted(set(ids), key=lambda s: (s.lower(), s))


def fetch_models(base_url, key):
    data = request_json(models_endpoint(base_url), key, timeout=10)
    return parse_model_ids(data)


def test_sentence_conversion(
    base_url,
    key,
    model,
    prompt="",
    sample="ni mingtian you shijian ma",
    thinking_mode="default",
    extra_request_json="",
):
    sys_prompt = prompt.strip() or default_sentence_prompt()
    extra_fields = resolve_extra_request_fields(thinking_mode, extra_request_json, strict=True)
    payload = {
        "model": model.strip(),
        "stream": False,
        **extra_fields,
        "messages": [
            {"role": "system", "content": sys_prompt},
            {"role": "user", "content": sample},
        ],
    }
    started = time.monotonic()
    data = request_json(chat_endpoint(base_url), key, payload=payload, timeout=20)
    elapsed = time.monotonic() - started
    try:
        content = data["choices"][0]["message"]["content"]
    except (KeyError, IndexError, TypeError):
        raise ApiError("服务没有返回 choices[0].message.content") from None
    cleaned = strip_think(str(content))
    if not cleaned:
        raise ApiError("模型返回内容为空")
    return cleaned, elapsed


def run_self_test():
    import tempfile
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    with tempfile.TemporaryDirectory() as tmp:
        cfg_path = os.path.join(tmp, "yuntype.conf")
        key_path = os.path.join(tmp, "api.key")

        vals, extra = read_config(cfg_path)
        assert vals == DEFAULTS and extra == []

        vals["TriggerKey"] = "Control+U"
