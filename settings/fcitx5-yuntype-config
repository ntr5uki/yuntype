    def on_nav_selected(self, _box, row):
        if row is not None and self.stack.get_visible_child_name() != row.page_name:
            self.stack.set_visible_child_name(row.page_name)

    def on_page_changed(self, *_args):
        name = self.stack.get_visible_child_name()
        row = self.nav_rows.get(name)
        if row is not None and self.nav.get_selected_row() is not row:
            self.nav.select_row(row)
