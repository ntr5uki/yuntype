        vals["HistoryCount"] = "15"
        vals["PersistIdleSeconds"] = "45"
        vals["PersistMaxSeconds"] = "600"
        vals["ShortCandidateThreshold"] = "8"
        vals["CandidatePageSize"] = "7"
        vals["SentencePrompt"] = "第一行\n第二行 \"引号\""
        write_config(vals, ["# comment\n"], cfg_path)

        loaded, loaded_extra = read_config(cfg_path)
        assert loaded["TriggerKey"] == "Control+U"
        assert loaded["HistoryEnabled"] == "True"
        assert loaded["HistoryCount"] == "15"
        assert loaded["PersistIdleSeconds"] == "45"
        assert loaded["PersistMaxSeconds"] == "600"
        assert loaded["ShortCandidateThreshold"] == "8"
        assert loaded["CandidatePageSize"] == "7"
        assert loaded["SentencePrompt"] == "第一行\n第二行 \"引号\""
        assert loaded_extra == ["# comment\n"]

        # Verify clamping and deprecated key cleanup
        with open(cfg_path, "a", encoding="utf-8") as f:
            f.write("ShortCandidateThreshold=999\nCandidateLimit=20\nCandidatePageSize=99\n")
        clamped, clamped_extra = read_config(cfg_path)
        assert clamped["ShortCandidateThreshold"] == "200"
        assert clamped["CandidatePageSize"] == "10"
        assert all("CandidateLimit" not in line for line in clamped_extra)

        write_api_key(" sk-secret-123 \n", key_path)
        assert read_api_key(key_path) == "sk-secret-123"
        assert (os.stat(key_path).st_mode & 0o777) == 0o600
        write_api_key("", key_path)
        assert not os.path.exists(key_path) and read_api_key(key_path) == ""

        # Multi-model profiles: auto-seed, add, edit, persist 0600, switch, delete
        models_path = os.path.join(tmp, "models.json")
        profiles, active_id = read_model_profiles(loaded, "sk-legacy", models_path)
        assert len(profiles) == 1 and profiles[0]["id"] == active_id
        assert profiles[0]["api_key"] == "sk-legacy"

        p2, created = upsert_model_profile(
            profiles,
            None,
            "本机 Ollama",
            "http://127.0.0.1:11434/v1",
            "qwen2.5:7b",
            "",
            "离线备用",
            "enable_thinking_false",
            "",
        )
        assert created and len(profiles) == 2 and p2["thinking_mode"] == "enable_thinking_false"
        p2_updated, created2 = upsert_model_profile(
            profiles,
            p2["id"],
            "本机 Qwen",
            "http://127.0.0.1:11434/v1",
            "qwen2.5:14b",
            "",
            "高质量",
            "custom",
            '{"reasoning":{"enabled":false}}',
        )
        assert not created2 and p2_updated["id"] == p2["id"] and len(profiles) == 2
        write_model_profiles(profiles, p2["id"], models_path)
        assert (os.stat(models_path).st_mode & 0o777) == 0o600

        loaded["BaseUrl"] = p2_updated["base_url"]
        loaded["Model"] = p2_updated["model"]
        reloaded_profiles, reloaded_active = read_model_profiles(loaded, "", models_path)
        assert len(reloaded_profiles) == 2 and reloaded_active == p2["id"]
        assert reloaded_profiles[1]["name"] == "本机 Qwen" and reloaded_profiles[1]["note"] == "高质量"
        assert reloaded_profiles[1]["thinking_mode"] == "custom"
        assert reloaded_profiles[1]["extra_request_json"] == '{"reasoning":{"enabled":false}}'
        assert resolve_extra_request_fields("reasoning_effort_none") == {"reasoning_effort": "none"}
        assert resolve_extra_request_fields("custom", '{"reasoning":{"enabled":false}}') == {
            "reasoning": {"enabled": False}
        }
        try:
            resolve_extra_request_fields("custom", '{"model":"hack"}')
            raise AssertionError("Expected reserved key rejection")
        except ApiError:
            pass
        try:
            resolve_extra_request_fields("custom", "not json")
            raise AssertionError("Expected invalid JSON rejection")
        except ApiError:
            pass

        after_del, next_active, removed, active_changed = delete_model_profile(
            reloaded_profiles, reloaded_active, p2["id"]
        )
        assert removed and active_changed and len(after_del) == 1 and next_active == after_del[0]["id"]
        # Cannot delete last remaining profile
        still_one, _, removed_last, _ = delete_model_profile(after_del, next_active, next_active)
        assert not removed_last and len(still_one) == 1

        class MockHandler(BaseHTTPRequestHandler):
            def reply(self, code, payload):
                raw = json.dumps(payload, ensure_ascii=False).encode("utf-8")
                self.send_response(code)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(raw)))
                self.end_headers()
                self.wfile.write(raw)

            def do_GET(self):
                self.reply(200, {"data": [{"id": "deepseek-chat"}, {"id": "deepseek-reasoner"}]})

            def do_POST(self):
                length = int(self.headers.get("Content-Length", "0"))
                body = json.loads(self.rfile.read(length))
                if self.headers.get("Authorization") != "Bearer sk-ok":
                    self.reply(401, {"error": {"message": "bad key sk-bad"}})
                    return
                src = body["messages"][-1]["content"]
                tag = f"et={body.get('enable_thinking')}" if "enable_thinking" in body else "default"
                self.reply(
                    200,
                    {"choices": [{"message": {"content": f"<think>推理</think>你明天有时间吗？（{src}|{tag}）"}}]},
                )

            def log_message(self, *_args):
                pass

        server = ThreadingHTTPServer(("127.0.0.1", 0), MockHandler)
        threading.Thread(target=server.serve_forever, daemon=True).start()
        base = f"http://127.0.0.1:{server.server_address[1]}/v1"
        assert fetch_models(base, "sk-ok") == ["deepseek-chat", "deepseek-reasoner"]
        assert parse_model_ids({"models": [{"name": "qwen3"}, {"id": "ds4"}]}) == ["ds4", "qwen3"]
        assert parse_model_ids(["zeta", "alpha", "alpha"]) == ["alpha", "zeta"]
        text, _sec = test_sentence_conversion(base, "sk-ok", "deepseek-chat")
        assert text.startswith("你明天有时间吗？") and "|default）" in text, text
        text2, _sec2 = test_sentence_conversion(
            base, "sk-ok", "deepseek-chat", thinking_mode="enable_thinking_false"
        )
        assert "|et=False）" in text2, text2
        try:
            test_sentence_conversion(base, "sk-bad", "deepseek-chat")
            raise AssertionError("Expected 401")
        except ApiError as e:
            assert "401" in str(e) and "sk-bad" not in str(e), e
        server.shutdown()
    print("self-test ok")


if "--self-test" in sys.argv:
    run_self_test()
    sys.exit(0)

