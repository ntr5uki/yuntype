        if hasattr(Adw, "SwitchRow"):
            row = Adw.SwitchRow(title=title, subtitle=subtitle or "")
            row.set_active(self.values.get(key, DEFAULTS[key]) == "True")
            row.connect("notify::active", lambda r, _p: self.set_value(key, "True" if r.get_active() else "False"))
            return row
        row = Adw.ActionRow(title=title, subtitle=subtitle or "")
        sw = Gtk.Switch(valign=Gtk.Align.CENTER, active=self.values.get(key, DEFAULTS[key]) == "True")
        sw.connect("notify::active", lambda s, _p: self.set_value(key, "True" if s.get_active() else "False"))
        row.add_suffix(sw)
        row.set_activatable_widget(sw)
        return row

