    def find_profile(self, profile_id):
        for p in self.profiles:
            if p["id"] == profile_id:
                return p
        return None

    def on_thinking_mode_changed(self, *_args):
        if hasattr(self, "extra_json_row"):
            idx = self.thinking_row.get_selected()
            mode = THINKING_MODE_IDS[idx] if 0 <= idx < len(THINKING_MODE_IDS) else "default"
            self.extra_json_row.set_visible(mode == "custom")

    def set_editor_fields(
        self, name, base_url, api_key, model, note, thinking_mode="default", extra_request_json=""
    ):
        self.provider_syncing = True
        try:
            self.name_row.set_text(name or "")
            self.url_row.set_text(base_url or "")
            self.provider_row.set_selected(provider_index(base_url or ""))
            self.key_row.set_text(api_key or "")
            self.model_row.set_text(model or "")
            self.thinking_row.set_selected(thinking_mode_index(thinking_mode))
            self.extra_json_row.set_text(extra_request_json or "")
            self.on_thinking_mode_changed()
            self.note_row.set_text(note or "")
        finally:
            self.provider_syncing = False
        self.models_cache = None
        self.models_for = None

    def refresh_editor_header(self):
        prof = self.find_profile(self.editing_profile_id) if self.editing_profile_id else None
        if prof:
            tag = "（使用中）" if prof["id"] == self.active_profile_id else ""
            self.editor_group.set_title(GLib.markup_escape_text(f"正在编辑：{prof['name']}{tag}"))
            self.save_profile_btn.set_label("保存更改")
            self.reset_edit_btn.set_label("还原")
        else:
            self.editor_group.set_title("新建模型配置")
            self.save_profile_btn.set_label("保存为新配置")
            self.reset_edit_btn.set_label("取消新建")
        self.test_row.set_subtitle("可先用「ni mingtian you shijian ma」测试当前输入框中的配置，确认后保存")

    def load_profile_into_editor(self, profile_id, scroll=True):
        prof = self.find_profile(profile_id) or self.active_profile()
        if prof:
            self.editing_profile_id = prof["id"]
            self.set_editor_fields(
                prof["name"],
                prof["base_url"],
                prof["api_key"],
                prof["model"],
                prof.get("note", ""),
                prof.get("thinking_mode", "default"),
                prof.get("extra_request_json", ""),
            )
        else:
            self.editing_profile_id = None
            self.set_editor_fields("", "", "", "", "", "default", "")
        self.refresh_editor_header()
        self.rebuild_profiles_list()
        if scroll:
            if hasattr(self.models_page, "scroll_to_top"):
                self.models_page.scroll_to_top()
            self.name_row.grab_focus()

    def start_new_profile(self):
        self.editing_profile_id = None
        self.set_editor_fields("", "", "", "", "", "default", "")
        self.refresh_editor_header()
        self.rebuild_profiles_list()
        if hasattr(self.models_page, "scroll_to_top"):
            self.models_page.scroll_to_top()
        self.name_row.grab_focus()
        self.toast("已进入新建模式，填写后点击「保存为新配置」")

    def on_reset_editor(self):
        if self.editing_profile_id:
            self.load_profile_into_editor(self.editing_profile_id, scroll=False)
            self.toast("已还原为已保存的内容")
        else:
            self.load_profile_into_editor(self.active_profile_id, scroll=False)
            self.toast("已取消新建")

    def sync_active_profile_to_fcitx(self, prof):
        if self.save_source:
            GLib.source_remove(self.save_source)
            self.save_source = 0
        self.values["BaseUrl"] = prof["base_url"]
        self.values["Model"] = prof["model"]
        self.values["ThinkingMode"] = normalize_thinking_mode(prof.get("thinking_mode", "default"))
        self.values["ExtraRequestJson"] = (prof.get("extra_request_json", "") or "").strip()
        write_config(self.values, self.extra)
        write_api_key(prof["api_key"])
        self.reload_addon()
        self.refresh_model_link_subtitle()

    def current_editor_thinking(self):
        idx = self.thinking_row.get_selected()
        mode = THINKING_MODE_IDS[idx] if 0 <= idx < len(THINKING_MODE_IDS) else "default"
        extra_json = self.extra_json_row.get_text().strip()
        return mode, extra_json

    def on_save_profile_clicked(self):
        name = self.name_row.get_text().strip()
        base_url = self.url_row.get_text().strip()
        api_key = self.key_row.get_text().strip()
        model = self.model_row.get_text().strip()
        note = self.note_row.get_text().strip()
        thinking_mode, extra_request_json = self.current_editor_thinking()
        if not base_url or not model:
            self.toast("请先填写接口地址和模型名称")
            (self.url_row if not base_url else self.model_row).grab_focus()
            return
        try:
            resolve_extra_request_fields(thinking_mode, extra_request_json, strict=True)
        except ApiError as e:
            self.toast(str(e))
            self.extra_json_row.grab_focus()
            return

        saved, created = upsert_model_profile(
            self.profiles,
            self.editing_profile_id,
            name,
            base_url,
            model,
            api_key,
            note,
            thinking_mode,
            extra_request_json,
        )
        if not self.active_profile_id:
            self.active_profile_id = saved["id"]
        self.editing_profile_id = saved["id"]
        try:
            write_model_profiles(self.profiles, self.active_profile_id)
            if saved["id"] == self.active_profile_id:
                self.sync_active_profile_to_fcitx(saved)
        except OSError as e:
            self.toast(f"保存模型配置失败：{e.strerror}")
            return

        self.set_editor_fields(
            saved["name"],
            saved["base_url"],
            saved["api_key"],
            saved["model"],
            saved.get("note", ""),
            saved.get("thinking_mode", "default"),
            saved.get("extra_request_json", ""),
        )
        self.refresh_editor_header()
        self.rebuild_profiles_list()
        self.refresh_model_link_subtitle()
        if created:
            self.toast(f"已新建模型配置「{saved['name']}」")
        elif saved["id"] == self.active_profile_id:
            self.toast(f"已保存并生效「{saved['name']}」")
        else:
            self.toast(f"已保存「{saved['name']}」")

    def activate_profile(self, profile_id):
        prof = self.find_profile(profile_id)
        if not prof:
            return
        self.active_profile_id = prof["id"]
        try:
            write_model_profiles(self.profiles, self.active_profile_id)
            self.sync_active_profile_to_fcitx(prof)
        except OSError as e:
            self.toast(f"切换模型失败：{e.strerror}")
            return
        self.refresh_editor_header()
        self.rebuild_profiles_list()
        self.toast(f"已切换到模型「{prof['name']}」")

    def on_delete_profile(self, profile_id):
        prof = self.find_profile(profile_id)
        if not prof:
            return
        if len(self.profiles) <= 1:
            self.toast("至少需要保留一个模型配置")
            return
        deleted_name = prof["name"]
        new_profiles, new_active, removed, active_changed = delete_model_profile(
            self.profiles, self.active_profile_id, profile_id
        )
        if not removed:
            return
        self.profiles = new_profiles
        self.active_profile_id = new_active
        try:
            write_model_profiles(self.profiles, self.active_profile_id)
            if active_changed:
                cur = self.active_profile()
                if cur:
                    self.sync_active_profile_to_fcitx(cur)
        except OSError as e:
            self.toast(f"删除失败：{e.strerror}")
            return
        if self.editing_profile_id == profile_id:
            self.load_profile_into_editor(self.active_profile_id, scroll=False)
        else:
            self.refresh_editor_header()
            self.rebuild_profiles_list()
        self.refresh_model_link_subtitle()
        self.toast(f"已删除「{deleted_name}」")

    def rebuild_profiles_list(self):
        if not hasattr(self, "profiles_group"):
            return
        for row in self.profile_rows:
            self.profiles_group.remove(row)
        self.profile_rows.clear()

        for prof in self.profiles:
            pid = prof["id"]
            is_active = pid == self.active_profile_id
            is_editing = pid == self.editing_profile_id

            row = Adw.ActionRow()
            title_text = prof["name"]
            if is_editing:
                title_text = f"{title_text}（编辑中）"
            row.set_title(GLib.markup_escape_text(title_text))
            row.set_subtitle(GLib.markup_escape_text(profile_summary(prof)))

            btn_box = Gtk.Box(spacing=6, valign=Gtk.Align.CENTER)

            if is_active:
                use_btn = Gtk.Button(label="使用中", sensitive=False)
                use_btn.add_css_class("accent")
                btn_box.append(use_btn)
            else:
                use_btn = Gtk.Button(label="使用")
                use_btn.add_css_class("suggested-action")
                use_btn.connect("clicked", lambda _b, target=pid: self.activate_profile(target))
                btn_box.append(use_btn)

            edit_btn = Gtk.Button(label="编辑")
            edit_btn.connect("clicked", lambda _b, target=pid: self.load_profile_into_editor(target))
            btn_box.append(edit_btn)

            del_btn = Gtk.Button(
                icon_name="user-trash-symbolic",
                tooltip_text="删除该模型配置",
                sensitive=len(self.profiles) > 1,
            )
            del_btn.add_css_class("flat")
            del_btn.connect("clicked", lambda _b, target=pid: self.on_delete_profile(target))
            btn_box.append(del_btn)

            row.add_suffix(btn_box)
            self.profiles_group.add(row)
            self.profile_rows.append(row)

    def on_provider_selected(self, row, _param):
        if self.provider_syncing:
            return
        _name, purl, pmodel = PROVIDERS[row.get_selected()]
        if not purl:
            self.url_row.grab_focus()
            return
        prev_model = self.model_row.get_text().strip()
        suggested = {m for _, _, m in PROVIDERS if m}
        self.provider_syncing = True
        try:
            self.url_row.set_text(purl)
        finally:
            self.provider_syncing = False
        if not prev_model or prev_model in suggested:
            self.model_row.set_text(pmodel)

    def on_url_changed(self, row):
        text = row.get_text().strip()
        idx = provider_index(text)
        if not self.provider_syncing and self.provider_row.get_selected() != idx:
            self.provider_syncing = True
            try:
                self.provider_row.set_selected(idx)
            finally:
                self.provider_syncing = False

    def build_model_popover(self):
        box = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=6,
            margin_top=6,
            margin_bottom=6,
            margin_start=6,
            margin_end=6,
        )
        search_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.model_search = Gtk.SearchEntry(placeholder_text="搜索模型 ID", hexpand=True)
        self.model_search.connect("search-changed", lambda _e: self.model_list.invalidate_filter())
        search_bar.append(self.model_search)
        refresh_btn = Gtk.Button(
            icon_name="view-refresh-symbolic",
            tooltip_text="重新拉取模型列表",
        )
        refresh_btn.add_css_class("flat")
        refresh_btn.connect("clicked", lambda _b: self.load_models(force=True))
        search_bar.append(refresh_btn)
        box.append(search_bar)
        self.model_status = Gtk.Label(wrap=True, max_width_chars=36, xalign=0)
        self.model_status.add_css_class("dim-label")
        box.append(self.model_status)
        self.model_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        self.model_list.add_css_class("navigation-sidebar")
        self.model_list.set_filter_func(self.filter_model_row)
        self.model_list.connect("row-activated", self.on_model_picked)
        scroll = Gtk.ScrolledWindow(
            child=self.model_list,
            min_content_height=260,
            min_content_width=300,
            hscrollbar_policy=Gtk.PolicyType.NEVER,
        )
        box.append(scroll)
        pop = Gtk.Popover(child=box)
        pop.connect("show", lambda _p: self.load_models())
        return pop

    def filter_model_row(self, row):
        q = self.model_search.get_text().strip().lower()
        return not q or q in row.model_id.lower()

    def load_models(self, force=False):
        base = self.url_row.get_text().strip()
        key = self.key_row.get_text().strip()
        self.model_search.set_text("")
        if not base:
            self.fill_models(None, "请先填写接口地址")
            return
        token = (base, key)
        if not force and self.models_cache is not None and self.models_for == token:
            self.fill_models(self.models_cache, None)
            return
        self.fill_models([], "正在获取模型列表…")
        self.models_for = token

        def work():
            try:
                res = (fetch_models(base, key), None)
            except ApiError as e:
                res = (None, str(e))
            GLib.idle_add(self.on_models_loaded, token, *res)

        threading.Thread(target=work, daemon=True).start()

    def on_models_loaded(self, token, models, error):
        if token != self.models_for:
            return GLib.SOURCE_REMOVE
        self.models_cache = models
        if models is None:
            self.models_for = None
            self.fill_models(None, f"获取失败：{error}")
        elif not models:
            self.fill_models([], "接口未返回模型列表，请直接输入模型名")
        elif len(models) == 1:
            self.model_row.set_text(models[0])
            self.fill_models(models, f"已自动填入唯一模型：{models[0]}")
            self.model_btn.popdown()
        else:
            self.fill_models(models, f"共 {len(models)} 个模型，支持关键词搜索")
        return GLib.SOURCE_REMOVE

    def fill_models(self, models, status):
        self.model_list.remove_all()
        self.model_status.set_label(status or "")
        self.model_status.set_visible(bool(status))
        for m in models or []:
            lbl = Gtk.Label(label=m, xalign=0, ellipsize=Pango.EllipsizeMode.MIDDLE)
            row = Gtk.ListBoxRow(child=lbl)
            row.model_id = m
            self.model_list.append(row)

    def on_model_picked(self, _listbox, row):
        self.model_row.set_text(row.model_id)
        self.model_btn.popdown()

    def on_test_clicked(self, _btn):
        base = self.url_row.get_text().strip()
        model = self.model_row.get_text().strip()
        key = self.key_row.get_text().strip()
        prompt = self.values.get("SentencePrompt", "")
        thinking_mode, extra_request_json = self.current_editor_thinking()
        if not base or not model:
            self.test_row.set_subtitle("请先填写接口地址和模型名称")
            return
        try:
            resolve_extra_request_fields(thinking_mode, extra_request_json, strict=True)
        except ApiError as e:
            self.test_row.set_subtitle(f"✗ {e}")
            return
        self.test_btn.set_sensitive(False)
        self.test_row.set_subtitle("正在请求模型…")

        def work():
            try:
                text, sec = test_sentence_conversion(
                    base,
                    key,
                    model,
                    prompt,
                    thinking_mode=thinking_mode,
                    extra_request_json=extra_request_json,
                )
                res = (text, sec, None)
            except ApiError as e:
                res = (None, 0.0, str(e))
            GLib.idle_add(self.on_test_done, *res)

        threading.Thread(target=work, daemon=True).start()

    def on_test_done(self, text, sec, error):
        self.test_btn.set_sensitive(True)
        if error:
            self.test_row.set_subtitle(f"✗ {error}")
        else:
            self.test_row.set_subtitle(f"✓ ni mingtian you shijian ma → {text}（{sec:.2f} 秒）")
        return GLib.SOURCE_REMOVE


class SettingsApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.page = None
        self.add_main_option(
            "page",
            0,
            GLib.OptionFlags.NONE,
            GLib.OptionArg.STRING,
            "打开指定设置页：sentence 或 models",
            "PAGE",
        )

    def do_command_line(self, command_line):
        opts = command_line.get_options_dict().end().unpack()
        self.page = opts.get("page")
        self.activate()
        return 0

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = SettingsWindow(self, self.page)
        elif self.page:
            win.show_page(self.page)
        win.present()


if __name__ == "__main__":
    sys.exit(SettingsApp().run(sys.argv))
