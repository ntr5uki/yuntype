        self.header_title.set_label(titles.get(name, "云打（YunType）设置"))

    def set_value(self, key, value):
        if self.values.get(key) == value:
            return
        self.values[key] = value
        if self.save_source:
            GLib.source_remove(self.save_source)
        self.save_source = GLib.timeout_add(250, self.flush_config)

    def flush_config(self):
        self.save_source = 0
        try:
            write_config(self.values, self.extra)
        except OSError as e:
            self.toast(f"保存设置失败：{e.strerror}")
            return GLib.SOURCE_REMOVE
        self.reload_addon()
        return GLib.SOURCE_REMOVE

    def reload_addon(self):
        if not self.bus:
            return
        for dest, path, iface, method, args in (
            (*ADDON_BUS, "ReloadConfig", None),
            (*FCITX_CONTROLLER, "ReloadAddonConfig", GLib.Variant("(s)", ("yuntype",))),
        ):
            try:
                self.bus.call(
                    dest, path, iface, method, args, None, Gio.DBusCallFlags.NO_AUTO_START, 1500, None, None
                )
            except GLib.Error:
                pass

    def on_close_request(self, *_args):
        if self.save_source:
            GLib.source_remove(self.save_source)
            self.flush_config()
        return False

