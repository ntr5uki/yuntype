            spin.set_value(val)
            spin.connect("notify::value", lambda r, _p: self.set_value(key, str(int(r.get_value()))))
            return spin
        row = Adw.ActionRow(title=title, subtitle=subtitle)
        adj = Gtk.Adjustment(value=val, lower=lo, upper=hi, step_increment=step, page_increment=step * 10)
        btn = Gtk.SpinButton(adjustment=adj, numeric=True, valign=Gtk.Align.CENTER)
        btn.connect("value-changed", lambda b: self.set_value(key, str(int(b.get_value()))))
