class SettingsWindow(Adw.ApplicationWindow):
    def __init__(self, app, initial_page=None):
        super().__init__(application=app, title="大模型整句输入设置")
        self.values, self.extra = read_config()
        self.save_source = 0
        self.key_source = 0
        self.models_cache = None
        self.models_for = None
        try:
            self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        except GLib.Error:
            self.bus = None

        self.set_default_size(820, 620)
        self.toasts = Adw.ToastOverlay()
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.NONE)

        pages = (
            ("sentence", "整句输入", "document-edit-symbolic", self.build_sentence_page),
            ("models", "模型服务", "preferences-system-network-symbolic", self.build_models_page),
        )
        self.nav = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        self.nav.add_css_class("navigation-sidebar")
        self.nav_rows = {}
        for name, title, icon, builder in pages:
            self.stack.add_titled(builder(), name, title)
            box = Gtk.Box(spacing=12, margin_top=6, margin_bottom=6, margin_start=8, margin_end=8)
            box.append(Gtk.Image(icon_name=icon))
            box.append(Gtk.Label(label=title, xalign=0))
            row = Gtk.ListBoxRow(child=box)
            row.page_name = name
            self.nav.append(row)
            self.nav_rows[name] = row

        self.nav.connect("row-selected", self.on_nav_selected)
        self.stack.connect("notify::visible-child-name", self.on_page_changed)

        side_header = Adw.HeaderBar(show_end_title_buttons=False)
        side_header.set_title_widget(Gtk.Label(label="整句大模型", css_classes=["title-4"]))
        side_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        side_box.append(side_header)
        side_box.append(self.nav)
        side_box.set_size_request(200, -1)

        content_header = Adw.HeaderBar(show_start_title_buttons=False)
        self.header_title = Gtk.Label(label="", css_classes=["title-4"])
        content_header.set_title_widget(self.header_title)

        content_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True)
        content_box.append(content_header)
        self.toasts.set_child(self.stack)
        content_box.append(self.toasts)

        split = Gtk.Box()
        split.append(side_box)
        split.append(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL))
        split.append(content_box)
        self.set_content(split)
        self.show_page(initial_page or "sentence")

    def toast(self, message):
        self.toasts.add_toast(Adw.Toast.new(message))

    def show_page(self, name):
        if name not in self.nav_rows:
            name = "sentence"
        self.stack.set_visible_child_name(name)
        self.on_page_changed()

    def on_nav_selected(self, _box, row):
        if row is not None and self.stack.get_visible_child_name() != row.page_name:
            self.stack.set_visible_child_name(row.page_name)

    def on_page_changed(self, *_args):
        name = self.stack.get_visible_child_name()
        row = self.nav_rows.get(name)
        if row is not None and self.nav.get_selected_row() is not row:
            self.nav.select_row(row)
        titles = {"sentence": "整句输入", "models": "模型服务"}
        self.header_title.set_label(titles.get(name, "大模型整句输入设置"))

    def set_value(self, key, value):
        if self.values.get(key) == value:
            return
        self.values[key] = value
        if self.save_source:
            GLib.source_remove(self.save_source)
        self.save_source = GLib.timeout_add(250, self.flush_config)

    def flush_config(self):
        self.save_source = 0
        try:
            write_config(self.values, self.extra)
        except OSError as e:
            self.toast(f"保存设置失败：{e.strerror}")
            return GLib.SOURCE_REMOVE
        self.reload_addon()
        return GLib.SOURCE_REMOVE

    def reload_addon(self):
        if not self.bus:
            return
        for dest, path, iface, method, args in (
            (*ADDON_BUS, "ReloadConfig", None),
            (*FCITX_CONTROLLER, "ReloadAddonConfig", GLib.Variant("(s)", ("llm_sentence",))),
        ):
            try:
                self.bus.call(
                    dest, path, iface, method, args, None, Gio.DBusCallFlags.NO_AUTO_START, 1500, None, None
                )
            except GLib.Error:
                pass

    def make_switch(self, key, title, subtitle=None):
        if hasattr(Adw, "SwitchRow"):
            row = Adw.SwitchRow(title=title, subtitle=subtitle or "")
            row.set_active(self.values.get(key, DEFAULTS[key]) == "True")
            row.connect("notify::active", lambda r, _p: self.set_value(key, "True" if r.get_active() else "False"))
            return row
        row = Adw.ActionRow(title=title, subtitle=subtitle or "")
        sw = Gtk.Switch(valign=Gtk.Align.CENTER, active=self.values.get(key, DEFAULTS[key]) == "True")
        sw.connect("notify::active", lambda s, _p: self.set_value(key, "True" if s.get_active() else "False"))
        row.add_suffix(sw)
        row.set_activatable_widget(sw)
        return row

