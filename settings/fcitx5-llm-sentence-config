def unquote_value(value):
    if len(value) >= 2 and value[0] == '"' and value[-1] == '"':
        inner = value[1:-1]
        out = []
        i = 0
        while i < len(inner):
            if inner[i] == "\\" and i + 1 < len(inner):
                nxt = inner[i + 1]
                out.append("\n" if nxt == "n" else nxt)
                i += 2
            else:
                out.append(inner[i])
                i += 1
        return "".join(out)
    return value


def quote_value(value):
    if any(c in value for c in ('\n', '"', '\\')) or value != value.strip():
        escaped = value.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")
        return f'"{escaped}"'
    return value


def read_config(path=None):
    target = path or CONFIG_FILE
    values = dict(DEFAULTS)
    extra = []
    if not os.path.isfile(target):
        return values, extra
    with open(target, encoding="utf-8", errors="replace") as f:
        in_section = False
        for raw in f:
            stripped = raw.strip()
            if not stripped or stripped.startswith("#"):
                extra.append(raw)
                continue
            if stripped.startswith("[") and stripped.endswith("]"):
                in_section = True
                extra.append(raw)
                continue
            if in_section or "=" not in raw:
                extra.append(raw)
                continue
            k, v = raw.split("=", 1)
            k = k.strip()
            v = unquote_value(v.strip())
            if k in DEFAULTS:
                if DEFAULTS[k] in ("True", "False"):
                    values[k] = v if v in ("True", "False") else DEFAULTS[k]
                elif k in RANGES:
                    lo, hi = RANGES[k]
                    try:
                        values[k] = str(max(lo, min(hi, int(v))))
                    except ValueError:
                        values[k] = DEFAULTS[k]
                else:
                    values[k] = v
            else:
                extra.append(raw)
    return values, extra


def write_config(values, extra=None, path=None):
    target = path or CONFIG_FILE
    os.makedirs(os.path.dirname(target), exist_ok=True)
    lines = []
    for k, default in DEFAULTS.items():
        val = values.get(k, default)
        lines.append(f"{k}={quote_value(val)}\n")
    for raw in extra or []:
        if raw.strip():
            lines.append(raw if raw.endswith("\n") else raw + "\n")
    tmp = f"{target}.tmp.{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as f:
        f.writelines(lines)
    os.replace(tmp, target)


def read_api_key(path=None):
    target = path or KEY_FILE
    for candidate in (target, WOWTYPE_KEY_FILE) if path is None else (target,):
        if candidate and os.path.isfile(candidate):
            try:
                with open(candidate, encoding="utf-8", errors="replace") as f:
                    key = f.readline().strip()
                    if key:
                        return key
            except OSError:
                pass
    return ""


def write_api_key(key, path=None):
    target = path or KEY_FILE
    key = key.strip()
    if not key:
        try:
            os.unlink(target)
        except FileNotFoundError:
            pass
        return
    os.makedirs(os.path.dirname(target), exist_ok=True)
    tmp = f"{target}.tmp.{os.getpid()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(key + "\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, target)


def chat_endpoint(base_url):
    base = base_url.strip().rstrip("/")
    return base if base.endswith("/chat/completions") else f"{base}/chat/completions"


def models_endpoint(base_url):
    base = base_url.strip().rstrip("/")
    if base.endswith("/chat/completions"):
        base = base[: -len("/chat/completions")]
    return base if base.endswith("/models") else f"{base}/models"


def is_loopback_url(url):
    try:
        host = (urllib.parse.urlparse(url.strip()).hostname or "").lower()
    except ValueError:
        return False
    return host in ("localhost", "127.0.0.1", "::1") or host.startswith("127.")


def provider_index(url):
    norm = url.strip().rstrip("/")
    for i, (_name, purl, _model) in enumerate(PROVIDERS[:-1]):
        if purl.rstrip("/") == norm:
            return i
    return len(PROVIDERS) - 1


def opener_for(url):
    if is_loopback_url(url):
        return urllib.request.build_opener(urllib.request.ProxyHandler({}))
    return urllib.request.build_opener()


class ApiError(Exception):
    pass


def redact(text, key):
    if key and len(key) >= 4:
        return text.replace(key, "***")
    return text


def request_json(url, key, payload=None, timeout=15):
    headers = {"Accept": "application/json", "User-Agent": f"fcitx5-llm-sentence/{VERSION}"}
    data = None
    if payload is not None:
        headers["Content-Type"] = "application/json"
        data = json.dumps(payload, ensure_ascii=False).encode("utf-8")
    if key:
        headers["Authorization"] = f"Bearer {key}"
    req = urllib.request.Request(url, data=data, headers=headers, method="POST" if data else "GET")
    try:
        with opener_for(url).open(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            return json.loads(raw)
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="replace")
        msg = f"HTTP {e.code}"
        try:
            err = json.loads(body).get("error", {})
            detail = err.get("message") if isinstance(err, dict) else str(err)
            if detail:
                msg = f"HTTP {e.code}：{detail}"
        except ValueError:
            if body.strip():
                msg = f"HTTP {e.code}：{body.strip()[:120]}"
        if e.code == 401:
            msg = f"API Key 不对或已失效（{msg}）"
        raise ApiError(redact(msg, key)) from None
    except urllib.error.URLError as e:
        raise ApiError(redact(f"连不上服务：{e.reason}", key)) from None
    except TimeoutError:
        raise ApiError("连接超时") from None
    except ValueError as e:
        raise ApiError(f"返回格式不是 JSON：{e}") from None


def strip_think(text):
    while "<think>" in text:
        start = text.find("<think>")
        end = text.find("</think>", start + 7)
        if end == -1:
            text = text[:start]
            break
        text = text[:start] + text[end + 8 :]
    return text.strip()


def fetch_models(base_url, key):
    data = request_json(models_endpoint(base_url), key, timeout=10)
    items = data.get("data") if isinstance(data, dict) else None
    if not isinstance(items, list):
        return []
    ids = [str(item.get("id", "")).strip() for item in items if isinstance(item, dict) and item.get("id")]
    return sorted(set(ids), key=lambda s: (s.lower(), s))


def test_sentence_conversion(base_url, key, model, prompt="", sample="ni mingtian you shijian ma"):
    sys_prompt = prompt.strip() or default_sentence_prompt()
    payload = {
        "model": model.strip(),
        "stream": False,
        "messages": [
            {"role": "system", "content": sys_prompt},
            {"role": "user", "content": sample},
        ],
    }
    started = time.monotonic()
    data = request_json(chat_endpoint(base_url), key, payload=payload, timeout=20)
    elapsed = time.monotonic() - started
    try:
        content = data["choices"][0]["message"]["content"]
    except (KeyError, IndexError, TypeError):
        raise ApiError("服务没有返回 choices[0].message.content") from None
    cleaned = strip_think(str(content))
    if not cleaned:
        raise ApiError("模型返回内容为空")
    return cleaned, elapsed


def run_self_test():
    import tempfile
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    with tempfile.TemporaryDirectory() as tmp:
        cfg_path = os.path.join(tmp, "llm_sentence.conf")
        key_path = os.path.join(tmp, "api.key")

        vals, extra = read_config(cfg_path)
        assert vals == DEFAULTS and extra == []

        vals["TriggerKey"] = "Control+U"
        vals["HistoryEnabled"] = "True"
        vals["HistoryCount"] = "15"
        vals["SentencePrompt"] = "第一行\n第二行 \"引号\""
        write_config(vals, ["# comment\n"], cfg_path)

        loaded, loaded_extra = read_config(cfg_path)
        assert loaded["TriggerKey"] == "Control+U"
        assert loaded["HistoryEnabled"] == "True"
        assert loaded["HistoryCount"] == "15"
        assert loaded["SentencePrompt"] == "第一行\n第二行 \"引号\""
        assert loaded_extra == ["# comment\n"]

        write_api_key(" sk-secret-123 \n", key_path)
        assert read_api_key(key_path) == "sk-secret-123"
        assert (os.stat(key_path).st_mode & 0o777) == 0o600
        write_api_key("", key_path)
        assert not os.path.exists(key_path) and read_api_key(key_path) == ""

        class MockHandler(BaseHTTPRequestHandler):
            def reply(self, code, payload):
                raw = json.dumps(payload, ensure_ascii=False).encode("utf-8")
                self.send_response(code)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(raw)))
                self.end_headers()
                self.wfile.write(raw)

            def do_GET(self):
                self.reply(200, {"data": [{"id": "deepseek-chat"}, {"id": "deepseek-reasoner"}]})

            def do_POST(self):
                length = int(self.headers.get("Content-Length", "0"))
                body = json.loads(self.rfile.read(length))
                if self.headers.get("Authorization") != "Bearer sk-ok":
                    self.reply(401, {"error": {"message": "bad key sk-bad"}})
                    return
                src = body["messages"][-1]["content"]
                self.reply(
                    200,
                    {"choices": [{"message": {"content": f"<think>推理</think>你明天有时间吗？（{src}）"}}]},
                )

            def log_message(self, *_args):
                pass

        server = ThreadingHTTPServer(("127.0.0.1", 0), MockHandler)
        threading.Thread(target=server.serve_forever, daemon=True).start()
        base = f"http://127.0.0.1:{server.server_address[1]}/v1"
        assert fetch_models(base, "sk-ok") == ["deepseek-chat", "deepseek-reasoner"]
        text, _sec = test_sentence_conversion(base, "sk-ok", "deepseek-chat")
        assert text.startswith("你明天有时间吗？"), text
        try:
            test_sentence_conversion(base, "sk-bad", "deepseek-chat")
            raise AssertionError("Expected 401")
        except ApiError as e:
            assert "401" in str(e) and "sk-bad" not in str(e), e
        server.shutdown()
    print("self-test ok")


if "--self-test" in sys.argv:
    run_self_test()
    sys.exit(0)

