    def refresh_prompt_subtitle(self):
        custom = bool(self.values.get("SentencePrompt", "").strip())
        self.prompt_row.set_subtitle("使用自定义提示词" if custom else "使用默认提示词（自动断句与补齐标点）")

    def on_clear_history(self, button):
        if not self.bus:
            self.toast("无法连接会话 D-Bus 总线")
            return

        def done(conn, res):
            button.set_sensitive(True)
            try:
                conn.call_finish(res)
                self.toast("已清空整句输入历史")
            except GLib.Error:
                self.toast("清空失败，请确认 fcitx5 已加载 llm_sentence 模块")

        button.set_sensitive(False)
        self.bus.call(
            *ADDON_BUS, "ClearHistory", None, GLib.VariantType("()"), Gio.DBusCallFlags.NO_AUTO_START, 2000, None, done
        )

    def on_edit_prompt(self, _row):
        default = default_sentence_prompt()
        dialog = Gtk.Dialog(
            title="编辑整句输入提示词",
            transient_for=self,
            modal=True,
            use_header_bar=0,
            default_width=620,
            default_height=440,
        )
        dialog.add_button("恢复默认", 1)
        dialog.add_button("取消", Gtk.ResponseType.CANCEL)
        save_btn = dialog.add_button("保存", Gtk.ResponseType.ACCEPT)
        save_btn.add_css_class("suggested-action")

        area = dialog.get_content_area()
        area.set_spacing(12)
        area.set_margin_start(16)
        area.set_margin_end(16)
        area.set_margin_top(16)
        area.set_margin_bottom(12)

        hint = Gtk.Label(label="保存后从下一次整句转换起生效。留空或恢复默认时使用内置提示词。", xalign=0, wrap=True)
        hint.add_css_class("dim-label")
        area.append(hint)

        scroller = Gtk.ScrolledWindow(vexpand=True, has_frame=True)
        editor = Gtk.TextView(
            wrap_mode=Gtk.WrapMode.WORD_CHAR,
            left_margin=12,
            right_margin=12,
            top_margin=10,
            bottom_margin=10,
        )
        buf = editor.get_buffer()
        buf.set_text(self.values.get("SentencePrompt", "").strip() or default)
        scroller.set_child(editor)
        area.append(scroller)

        def on_resp(_dlg, resp):
            if resp == 1:
                buf.set_text(default)
                return
            if resp == Gtk.ResponseType.ACCEPT:
                text = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).strip()
                text = "" if text == default else text
                self.values["SentencePrompt"] = text
                write_config(self.values, self.extra)
                self.refresh_prompt_subtitle()
                self.reload_addon()
                self.toast("已保存提示词")
            dialog.destroy()

        dialog.connect("response", on_resp)
        dialog.present()

    def build_models_page(self):
